<?xml version="1.0"?>
<!--
  Pi0 + MuJoCo 桌面抓取仿真场景
  - 单 6 自由度机械臂（肩旋转/肩俯仰/肘/腕1/腕2/腕3）+ 二指夹爪
  - 桌面、杯子、方块
  - 两个相机：俯视全局相机(global_cam) + 腕部相机(wrist_cam)
  修改物体位置：直接调整 <body> 中 cup / block 的 pos 属性即可

  说明：关节/body 名称与 run_pi0_grasp.py 完全对应，仅改进了视觉外观。
-->
<mujoco model="pi0_grasp_scene">

  <compiler angle="degree" coordinate="local" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="1.0 0.005 0.0001" solimp="0.9 0.95 0.001" solref="0.02 1"/>
    <joint armature="0.01" damping="0.5" limited="true"/>
    <motor ctrllimited="true"/>
  </default>

  <!-- 材质与配色（工业机械臂风格：深灰底座 + 白色连杆 + 橙色关节环） -->
  <asset>
    <texture name="table_tex" type="2d" builtin="checker" rgb1="0.6 0.5 0.4" rgb2="0.5 0.4 0.3" width="300" height="300"/>
    <material name="table_mat"  texture="table_tex" texrepeat="4 4" reflectance="0.2"/>
    <material name="cup_mat"    rgba="0.2 0.5 0.9 1.0" shininess="0.6"/>
    <material name="block_mat"  rgba="0.9 0.2 0.2 1.0"/>
    <material name="base_mat"   rgba="0.25 0.25 0.28 1.0"/>       <!-- 底座：深灰 -->
    <material name="link_mat"   rgba="0.92 0.93 0.95 1.0"/>       <!-- 连杆：白 -->
    <material name="joint_mat"  rgba="0.95 0.45 0.10 1.0"/>       <!-- 关节环：橙 -->
    <material name="grip_mat"   rgba="0.30 0.30 0.33 1.0"/>       <!-- 夹爪：深灰 -->
  </asset>

  <worldbody>
    <!-- 地面 -->
    <geom name="floor" type="plane" size="5 5 0.1" pos="0 0 0" material="table_mat" condim="3"/>

    <!-- 桌面 -->
    <geom name="table" type="box" size="0.6 0.6 0.02" pos="0.5 0 0.4" material="table_mat"/>
    <geom name="table_leg1" type="cylinder" size="0.03 0.4" pos="0.1 0.5 0.2" material="base_mat"/>
    <geom name="table_leg2" type="cylinder" size="0.03 0.4" pos="0.9 0.5 0.2" material="base_mat"/>
    <geom name="table_leg3" type="cylinder" size="0.03 0.4" pos="0.1 -0.5 0.2" material="base_mat"/>
    <geom name="table_leg4" type="cylinder" size="0.03 0.4" pos="0.9 -0.5 0.2" material="base_mat"/>

    <!-- 全局俯视相机 -->
    <camera name="global_cam" pos="0.55 -0.35 1.5" xyaxes="1 0 0 0 1 0"/>

    <!-- ===================== 6-DOF 机械臂 ===================== -->
    <body name="base" pos="0.1 0 0.42">
      <!-- 底座：圆盘 + 立柱 -->
      <geom name="base_plate"  type="cylinder" size="0.10 0.02" material="base_mat"/>
      <geom name="base_pillar" type="cylinder" size="0.05 0.04" pos="0 0 0.04" material="base_mat"/>

      <!-- 关节1: 肩旋转 (绕 z) -->
      <body name="shoulder_pan" pos="0 0 0.08">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-170 170"/>
        <geom name="j1_housing" type="cylinder" size="0.06 0.03" material="joint_mat"/>   <!-- 橙色关节环 -->
        <geom name="j1_link"    type="cylinder" size="0.05 0.04" pos="0 0 0.04" material="link_mat"/>

        <!-- 关节2: 肩俯仰 (绕 y) -->
        <body name="shoulder_lift" pos="0 0 0.08">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-110 110"/>
          <geom name="j2_housing" type="sphere" size="0.055" material="joint_mat"/>
          <!-- 大臂：胶囊形连杆（沿 +z 方向） -->
          <geom name="upper_arm" type="capsule" fromto="0 0 0  0 0 0.28" size="0.035" material="link_mat"/>

          <!-- 关节3: 肘 (绕 y) -->
          <body name="elbow" pos="0 0 0.28">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-120 120"/>
            <geom name="j3_housing" type="sphere" size="0.05" material="joint_mat"/>
            <!-- 小臂：胶囊形连杆 -->
            <geom name="forearm" type="capsule" fromto="0 0 0  0 0 0.26" size="0.03" material="link_mat"/>

            <!-- 关节4: 腕1 (绕 z) -->
            <body name="wrist1" pos="0 0 0.26">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-170 170"/>
              <geom name="j4_housing" type="cylinder" size="0.035 0.025" material="joint_mat"/>

              <!-- 关节5: 腕2 (绕 y) -->
              <body name="wrist2" pos="0 0 0.05">
                <joint name="joint5" type="hinge" axis="0 1 0" range="-120 120"/>
                <geom name="j5_housing" type="sphere" size="0.03" material="joint_mat"/>

                <!-- 关节6: 腕3 (绕 z) -->
                <body name="wrist3" pos="0 0 0.04">
                  <joint name="joint6" type="hinge" axis="0 0 1" range="-170 170"/>
                  <geom name="j6_housing" type="cylinder" size="0.028 0.02" material="joint_mat"/>

                  <!-- 末端执行器(夹爪基座) -->
                  <body name="ee" pos="0 0 0.04">
                    <geom name="ee_base" type="box" size="0.03 0.04 0.02" material="grip_mat"/>

                    <!-- 左指 -->
                    <body name="left_finger" pos="0 0.03 0">
                      <joint name="finger_left" type="slide" axis="0 -1 0" range="0 0.035"/>
                      <geom name="left_pad" type="box" size="0.015 0.012 0.05" pos="0 0.012 0" material="grip_mat"/>
                      <geom name="left_tip" type="box" size="0.015 0.02 0.01" pos="0 0.012 -0.04" material="joint_mat"/>
                    </body>

                    <!-- 右指 -->
                    <body name="right_finger" pos="0 -0.03 0">
                      <joint name="finger_right" type="slide" axis="0 1 0" range="0 0.035"/>
                      <geom name="right_pad" type="box" size="0.015 0.012 0.05" pos="0 -0.012 0" material="grip_mat"/>
                      <geom name="right_tip" type="box" size="0.015 0.02 0.01" pos="0 -0.012 -0.04" material="joint_mat"/>
                    </body>

                    <!-- 腕部相机 -->
                    <camera name="wrist_cam" pos="0 0 0.08" xyaxes="1 0 0 0 -1 0"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ===================== 抓取物体 ===================== -->
    <!-- 杯子 (可修改 pos 改变位置) -->
    <body name="cup" pos="0.5 0.10 0.46">
      <freejoint/>
      <geom name="cup_geom" type="cylinder" size="0.03 0.05" material="cup_mat" mass="0.1"/>
    </body>

    <!-- 方块 (可修改 pos 改变位置) -->
    <body name="block" pos="0.55 -0.10 0.43">
      <freejoint/>
      <geom name="block_geom" type="box" size="0.03 0.03 0.03" material="block_mat" mass="0.05"/>
    </body>
  </worldbody>

  <!-- ===================== 驱动器 ===================== -->
  <actuator>
    <motor name="m1"  joint="joint1"      gear="100" ctrlrange="-3.14 3.14"/>
    <motor name="m2"  joint="joint2"      gear="100" ctrlrange="-2.0 2.0"/>
    <motor name="m3"  joint="joint3"      gear="100" ctrlrange="-2.0 2.0"/>
    <motor name="m4"  joint="joint4"      gear="100" ctrlrange="-3.14 3.14"/>
    <motor name="m5"  joint="joint5"      gear="100" ctrlrange="-2.0 2.0"/>
    <motor name="m6"  joint="joint6"      gear="100" ctrlrange="-3.14 3.14"/>
    <motor name="grip_left"  joint="finger_left"  gear="20" ctrlrange="0 0.035"/>
    <motor name="grip_right" joint="finger_right" gear="20" ctrlrange="0 0.035"/>
  </actuator>

  <!-- 传感器 -->
  <sensor>
    <jointpos name="j1" joint="joint1"/>
    <jointpos name="j2" joint="joint2"/>
    <jointpos name="j3" joint="joint3"/>
    <jointpos name="j4" joint="joint4"/>
    <jointpos name="j5" joint="joint5"/>
    <jointpos name="j6" joint="joint6"/>
    <jointpos name="grip_l" joint="finger_left"/>
    <jointpos name="grip_r" joint="finger_right"/>
  </sensor>

</mujoco>
